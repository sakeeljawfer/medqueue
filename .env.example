# --- API ---
NODE_ENV=development
API_PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000

# Postgres
DATABASE_URL=postgresql://medqueue:medqueue_dev@localhost:5432/medqueue?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_ACCESS_SECRET=change-me-32-chars-minimum-secret-a
JWT_REFRESH_SECRET=change-me-32-chars-minimum-secret-b
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# SMS provider: NOTIFYLK | IDEABIZ | CONSOLE (dev: logs OTP to stdout)
SMS_PROVIDER=CONSOLE
NOTIFYLK_USER_ID=
NOTIFYLK_API_KEY=
NOTIFYLK_SENDER_ID=MedQueue
IDEABIZ_CLIENT_ID=
IDEABIZ_CLIENT_SECRET=

# Object storage (MinIO locally, any S3-compatible in prod)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=medqueue-uploads
S3_ACCESS_KEY=medqueue
S3_SECRET_KEY=medqueue_dev_secret
S3_FORCE_PATH_STYLE=true

# PayHere (sandbox)
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_MODE=sandbox

# Observability
SENTRY_DSN_API=
SENTRY_DSN_WEB=
NEXT_PUBLIC_SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000
